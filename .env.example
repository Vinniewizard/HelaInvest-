# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIPIA_API_KEY: Your Lipia Online API Key for STK Push integration.
# Extract this from https://lipia-online.vercel.app/dashboard
LIPIA_API_KEY=

# I&M BANK OTG APIS: Use either standard IMBANK_API_KEY or Client OAuth Credentials
# Retrieve credentials from your I&M Bank developer gateway.
IMBANK_API_KEY=
IMBANK_CLIENT_ID=
IMBANK_CLIENT_SECRET=
IMBANK_API_BASE_URL=https://api.sandbox.imbankgroup.com
IMBANK_MERCHANT_ACCOUNT=
IMBANK_SUBSCRIPTION_KEY=

# NOWPayments Crypto Gateway Configurations
# Get these credentials from your NOWPayments.io Dashboard Panel
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_IPN_SECRET=
IPN_CALLBACK_URL=

# Neon Serverless PostgreSQL Database Connection Credentials
# Create a serverless database at https://neon.tech and paste the connection URL string here.
DATABASE_URL=
NEON_DATABASE_URL=